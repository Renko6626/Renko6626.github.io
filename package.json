{
  "name": "renko-site",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --noEmit && vite build && node scripts/postbuild.mjs",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "vue-tsc --noEmit",
    "figure": "python3 scripts/make-figure.py",
    "fonts": "python3 scripts/build-fonts.py",
    "deploy": "bash scripts/deploy.sh"
  },
  "dependencies": {
    "naive-ui": "^2.42.0",
    "vue": "^3.5.13",
    "vue-i18n": "^11.1.1",
    "vue-router": "^4.5.0"
  },
  "devDependencies": {
    "@ibm/plex-mono": "^1.1.0",
    "@ibm/plex-sans": "^1.1.0",
    "@ibm/plex-sans-sc": "^1.1.0",
    "@vitejs/plugin-vue": "^5.2.1",
    "@types/node": "^22.13.0",
    "typescript": "^5.7.3",
    "unocss": "^66.0.0",
    "vite": "^6.1.0",
    "vitest": "^3.0.5",
    "vue-tsc": "^2.2.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}
